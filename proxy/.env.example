# File: proxy/.env.example
# Copy this file to proxy/.env and fill in real values.
# proxy/.env is listed in .gitignore — it must NEVER be committed to GitHub.

# Your institution's Canvas address, no trailing slash.
# Confirm the exact URL your browser shows when you're in Canvas.
CANVAS_BASE_URL=[PLACEHOLDER e.g. https://psu.instructure.com]

# Canvas Access Token. At Penn State, self-service token creation was disabled
# on May 20, 2026 — request one through an IT Help Desk ticket (KB0022890).
CANVAS_TOKEN=[PLACEHOLDER]

# Port for the local proxy (the dashboard defaults to 8787).
PORT=8787

# Comma-separated list of web origins allowed to call this proxy, besides
# http://127.0.0.1:8787 itself. Add your GitHub Pages origin here, e.g.
# https://your-github-username.github.io   (origin only — no path)
ALLOWED_ORIGINS=[PLACEHOLDER e.g. https://your-github-username.github.io]

# Safety cap on how many pages of results to follow per request.
MAX_PAGES=20
